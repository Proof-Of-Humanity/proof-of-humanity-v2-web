{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,loading,error,not-found,template,default}.{ts,tsx,js,jsx}",
    "src/middleware.{ts,js}",
    "netlify/functions/**/*.{ts,js}",
    "codegen.yml"
  ],
  "project": [
    "src/**/*.{ts,tsx,js,jsx}",
    "netlify/functions/**/*.{ts,js}",
    "*.config.{js,ts}",
    ".*rc.js",
    "*.config.js",
    "!src/generated/**",
    "!src/contracts/deployments/**/abi.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/generated/**": ["exports", "types", "enumMembers"],
    "src/contracts/deployments/**/abi.ts": ["exports", "types", "enumMembers"]
  },
  "ignoreDependencies": [
    "@ffmpeg/core-mt",
    "@svgr/webpack",
    "dotenv",
    "eslint",
    "eslint-config-next",
    "eslint-config-prettier",
    "pino-pretty"
  ]
}
